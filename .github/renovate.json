{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "minimumReleaseAge": "3 days",
  "ignorePaths": ["pkg/build/_test/Dockerfile*", "tests/build/Dockerfile*"],
  "nuget": {
    "ignorePaths": ["pkg/build/_test/*.csproj"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchDepTypes": ["action"],
      "matchPackageNames": ["3lvia/core-github-actions-templates"],
      "pinDigests": false
    }
  ]
}
