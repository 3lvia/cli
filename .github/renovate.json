{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "ignorePaths": [
    "pkg/build/_test/Dockerfile*",
    "tests/build/Dockerfile*"
  ],
  "nuget": {
    "ignorePaths": [
      "pkg/build/_test/*.csproj"
    ]
  }
}
